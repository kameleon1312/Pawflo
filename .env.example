# ============================================================
# PawFlo — Environment Variables Template
# Copy to .env.local for development. NEVER commit real values.
# Production secrets go to AWS Secrets Manager / Railway / Vercel env vars.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# --- Database (PostgreSQL 16) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: use port 5433 locally if native PostgreSQL is already on 5432
DATABASE_URL=postgresql://postgres:dev@localhost:5433/pawflo

# --- Redis (rate limiting, sessions) ---
REDIS_URL=redis://localhost:6379

# --- JWT secrets (generate with: openssl rand -base64 32) ---
JWT_ACCESS_SECRET=REPLACE_WITH_256_BIT_RANDOM_STRING_ACCESS
JWT_REFRESH_SECRET=REPLACE_WITH_256_BIT_RANDOM_STRING_REFRESH

# --- Encryption (AES-256-GCM, generate with: openssl rand -base64 32) ---
# Used for: phone numbers, chip IDs, home addresses, medical notes
ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# --- IP pseudonymisation (RODO) ---
# Salt for SHA-256 hashing of IP addresses stored in DB / audit logs.
# Without this, IPv4 hashes are reversible via rainbow table (~4B addresses).
# Generate with: openssl rand -base64 32
IP_SALT=REPLACE_WITH_RANDOM_SALT

# --- App base URL (used for email verification / password reset links) ---
APP_URL=http://localhost:3001

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=re_REPLACE_WITH_REAL_KEY
EMAIL_FROM=noreply@pawflo.pl

# --- Storage (Cloudflare R2 or AWS S3) ---
S3_BUCKET=pawflo-media
S3_REGION=auto
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=REPLACE_WITH_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET

# --- Monitoring ---
SENTRY_DSN=https://REPLACE@o0.ingest.sentry.io/0

# --- Google Maps (PawMap) ---
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_KEY

# --- Push notifications (FCM) ---
FCM_SERVER_KEY=REPLACE_WITH_FCM_SERVER_KEY
